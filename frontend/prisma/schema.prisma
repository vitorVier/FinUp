generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  userFunds    UserFund[]
  categories   TransactionCategory[]
  transactions Transaction[]
  recurrences  Recurrence[]
  goals        Goal[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserFund {
  id                 String    @id @default(cuid())
  userId             String
  papel              String
  list               FundList
  ultimaRecomendacao String?
  ultimaNotaFinal    Float?
  verificadoEm       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, papel])
}

model TransactionCategory {
  id        String          @id @default(cuid())
  userId    String
  name      String
  color     String
  type      TransactionType
  icon      String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurrences  Recurrence[]

  @@unique([userId, name, type])
}

model Transaction {
  id           String  @id @default(cuid())
  userId       String
  categoryId   String
  recurrencyId String?

  value       Decimal           @db.Decimal(10, 2)
  description String?
  date        DateTime          @db.Date
  paidAt      DateTime?         @db.Date
  status      TransactionStatus @default(PENDING)
  type        TransactionType

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category TransactionCategory @relation(fields: [categoryId], references: [id])

  goalContributions GoalContribution[]

  @@unique([userId, id])
}

model Recurrence {
  id         String            @id @default(cuid())
  userId     String
  name       String
  value      Decimal           @db.Decimal(10, 2)
  day        Int?
  status     TransactionStatus @default(PENDING)
  isActive   Boolean           @default(true)
  type       TransactionType
  categoryId String

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category TransactionCategory @relation(fields: [categoryId], references: [id])

  @@unique([userId, id])
}

model Goal {
  id            String       @id @default(cuid())
  userId        String
  name          String
  description   String?
  targetValue   Decimal      @db.Decimal(12, 2)
  currentValue  Decimal      @default(0) @db.Decimal(12, 2)
  status        GoalStatus   @default(ACTIVE)
  type          GoalType     @default(SAVING)
  targetDate    DateTime?
  monthlyTarget Decimal      @db.Decimal(12, 2)
  priority      GoalPriority @default(MEDIUM)
  color         String       @default("#ffffff")
  icon          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  completedAt   DateTime?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalContributions GoalContribution[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, targetDate])
}

model GoalContribution {
  id            String  @id @default(cuid())
  goalId        String
  transactionId String?

  value       Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  description String?

  goal        Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([goalId])
  @@index([transactionId])
}

enum FundList {
  WALLET
  WATCHLIST
}

enum TransactionType {
  INFLOW
  OUTFLOW
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum GoalType {
  SAVING
  INVESTMENT
  PURCHASE
  TRAVEL
  EMERGENCY
  DEBT
  OTHER
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}
